<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for the executable (command line) jar only; the library jar ships no logging
     configuration.  Log messages go to standard error, so that standard output carries only the
     program's output.  kurator-ffdq logs at INFO by default (what it is doing, to help isolate problems);
     set the level with -Dkurator.log.level=DEBUG for full tracing, or -Dkurator.log.level=WARN for warnings and errors only.
     Other libraries log warnings and errors. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_ERR">
      <PatternLayout pattern="%-5level %c{1.} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="org.datakurator" level="${sys:kurator.log.level:-INFO}"/>
    <Root level="WARN">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
